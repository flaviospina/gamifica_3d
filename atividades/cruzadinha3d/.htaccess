# ============================================================
#  .htaccess — atividades/cruzadinha3d
#  Libera o Three.js do jsDelivr (o .htaccess da raiz do Gamifica
#  bloqueia scripts externos). Vale só para esta pasta.
#  'unsafe-inline' é necessário: o importmap e o carregador ficam
#  dentro do index.php (mesma regra que a raiz já usa).
# ============================================================
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; worker-src 'self' blob:; frame-ancestors 'self'"
</IfModule>

# Módulos ES precisam do MIME correto
AddType application/javascript .js
AddType application/json .json

# Cache: os módulos ES importam uns aos outros sem ?v=, então o navegador
# NÃO pode guardar js/css por dias (misturaria versões antigas e novas).
# "no-cache" = sempre revalida com o servidor (ETag/Last-Modified): se não
# mudou, a resposta é 304 e nada é baixado de novo.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
